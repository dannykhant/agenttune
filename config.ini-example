[workload analyzer]
workload_file = ./workload analyzer/workloads/res.wg
config_file = ./workload analyzer/workloads/res.json
output_file = ./workload analyzer/workload_features

[knob selector]
api_key =
base_url = https://generativelanguage.googleapis.com/v1beta/openai/
model = gemini-3.5-flash-lite
candidate_knobs = ./knob selector/candidate_knobs
knob_num = 20
database_kernel = PostgreSQL 17
database_scale = 2GB
hardware = 2 cores, 2 GB RAM
output_file = ./knob selector/selected_knobs

[range pruner]
knob_details = ./range pruner/knob_details.json
model = gemini-3.5-flash-lite
output_file = ./range pruner/pruned_knobs

[configuration recommender]
model = gemini-3.5-flash-lite
top_k = 2
node_count = 3
history_num = 5
metric_file = ./configuration recommender/inner_metric
db_metric = throughput
LLM_server_IP = localhost
LLM_server_port = 4000
dbms = postgresql
PG_DataDir = /var/lib/postgresql/data
PG_ServiceName = postgresql
DB_RestartMethod = docker
PG_ContainerName = adcoexp-db
PG_RestartCommand = docker restart adcoexp-db
DB_IP =
DB_IP_Password =
DB_User = postgres
DB_Password = postgres
DB_Host = pgdb
DB_Name = agenttune
DB_Port = 5432
iteration = 100
QueryDir =
benchmark = SYSBENCH

[postgres]
database_kernel = PostgreSQL 17
dbms = postgresql
DB_IP =
DB_IP_Password =
DB_User = postgres
DB_Password = postgres
DB_Host = pgdb
DB_Name = agenttune
DB_Port = 5432
PG_DataDir = /var/lib/postgresql/data
PG_ServiceName = postgresql
DB_RestartMethod = docker
PG_ContainerName = adcoexp-db
PG_RestartCommand = docker restart adcoexp-db

[mysql]
database_kernel = MySQL 8.0
dbms = mysql
DB_IP =
DB_IP_Password =
DB_User = root
DB_Password = root
DB_Host = mysql
DB_Name = agenttune
DB_Port = 3306